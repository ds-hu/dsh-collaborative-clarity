{
  "name": "@ds-hu/dsh-collaborative-clarity",
  "version": "0.1.0",
  "description": "Artifact rounds in the right sidebar: the agent shows a decision, the user annotates and chooses, and the tool waits.",
  "license": "Apache-2.0",
  "author": "ds-hu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ds-hu/dsh-collaborative-clarity.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/ds-hu/dsh-collaborative-clarity/issues"
  },
  "homepage": "https://github.com/ds-hu/dsh-collaborative-clarity#readme",
  "icon": "./icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
